{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "Dub",
  "version": "0.1.0",
  "identifier": "dev.leonardogonzaga.dub",
  "build": {
    "frontendDist": "ui"
  },
  "app": {
    "withGlobalTauri": true,
    "windows": [
      {
        "title": "Dub — dublagem automática de vídeos",
        "label": "main",
        "width": 1040,
        "height": 720,
        "minWidth": 860,
        "minHeight": 600,
        "resizable": true,
        "center": true
      }
    ],
    "security": {
      "csp": "default-src 'self'; style-src 'self' 'unsafe-inline'; img-src 'self' data:"
    }
  },
  "bundle": {
    "active": true,
    "targets": ["nsis", "deb", "appimage", "dmg"],
    "icon": [
      "icons/32x32.png",
      "icons/128x128.png",
      "icons/128x128@2x.png",
      "icons/icon.icns",
      "icons/icon.ico"
    ],
    "category": "Video",
    "shortDescription": "Dublagem automática de vídeos (EN → PT-BR), 100% local",
    "longDescription": "Recebe um vídeo ou URL do YouTube em inglês e devolve o vídeo com áudio dublado em português, legenda embutida e a faixa original preservada. Transcrição (whisper.cpp), tradução (CTranslate2) e voz (Piper) rodam no seu computador.",
    "resources": {
      "../target/bundle-resources/": "./"
    },
    "windows": {
      "nsis": {
        "installMode": "currentUser",
        "languages": ["PortugueseBR", "English"],
        "displayLanguageSelector": false
      }
    },
    "linux": {
      "deb": { "depends": ["ffmpeg"] }
    },
    "macOS": {
      "minimumSystemVersion": "11.0"
    }
  }
}
